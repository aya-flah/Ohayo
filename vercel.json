{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "node apps/api/scripts/bundle-vercel.mjs && npm run build -w apps/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.mjs": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.mjs" },
    { "source": "/((?!api/|assets/|icons/).*)", "destination": "/index.html" }
  ]
}
