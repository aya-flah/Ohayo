# Copy to contracts/.env and fill in. Never commit the real file, never paste keys in chat.

# Sepolia RPC, e.g. from Alchemy or Infura, or https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=

# Private key of a TEST MetaMask account funded with Sepolia ETH from a faucet. Test accounts only.
DEPLOYER_PRIVATE_KEY=

# Address that may confirm measured deliveries (the Sonae server's oracle wallet). Defaults to the deployer.
ORACLE_ADDRESS=

# Optional, to verify the contracts on Etherscan too (free key from etherscan.io).
# Sourcify verification needs no key: npm --prefix contracts run verify:sepolia
ETHERSCAN_API_KEY=
