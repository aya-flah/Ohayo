# Copy to apps/web/.env.local. These are public (they ship in the app): never put secrets here.

# Sonae API (Claude notice reader, SMS, oracle). Leave empty to run fully offline.
VITE_API_URL=http://localhost:8787

# MQTT over WebSocket for live node data (Wokwi or the real ESP32), e.g. wss://broker.hivemq.com:8884/mqtt
VITE_MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt
VITE_MQTT_TOPIC=sonae/gda-kairouan-01/+/telemetry

# Optional Sepolia RPC for reading the Yui contracts. Empty = publicnode, then viem's default.
VITE_SEPOLIA_RPC_URL=

# Demo exchange rate used to show TND next to Sepolia ETH (test ETH has no value)
VITE_TND_PER_ETH=10000
