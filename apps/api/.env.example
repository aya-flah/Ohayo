# Copy to apps/api/.env. Never commit the real file. Never paste keys into chat.

PORT=8787
# Websites allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Claude (server-side only; the apps never see this key)
ANTHROPIC_API_KEY=
# Hard spending cap for all AI features, in US dollars
AI_BUDGET_USD=20

# Bearer token required for sensitive actions (oracle confirmations, admin)
API_TOKEN=change-me

# Yui delivery oracle: a TEST wallet holding ORACLE_ROLE on the exchange contract
ORACLE_PRIVATE_KEY=
CHAIN=sepolia
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Accounts seeded at startup (test values only; never real passwords). Sign-up creates mill and farmer accounts.
ADMIN_EMAIL=admin@sonae.tn
ADMIN_PASSWORD=
DEMO_MILL_EMAIL=mill@sonae.demo
DEMO_FARMER_EMAIL=farmer@sonae.demo
DEMO_PASSWORD=
# Optional: where the SQLite database lives (default apps/api/data/sonae.db)
DB_FILE=
